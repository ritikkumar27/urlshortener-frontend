---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Register | URL Shortener</title>
  </head>
  <body>
    <main class="min-h-screen w-full flex items-center justify-center p-4">
      
      <!-- Global Toast Container -->
      <div id="toast-container" class="toast toast-top toast-end z-50"></div>

      <div class="card w-full max-w-[450px] mx-auto bg-base-100 shadow-2xl border border-base-300">
        <div class="card-body">
          <h2 class="card-title text-3xl font-bold text-primary justify-center mb-2">
            Create an Account
          </h2>
          <p class="text-center text-base-content/70 mb-6">
            Join to track and manage your shortened links.
          </p>
          <form id="register-form" class="flex flex-col gap-4">
            
            <label class="form-control w-full">
              <div class="label">
                <span class="label-text font-medium">Name (Optional)</span>
              </div>
              <input 
                type="text" 
                id="name"
                name="name"
                placeholder="Optimus Prome" 
                class="input input-bordered w-full" 
              />
            </label>
            <label class="form-control w-full">
              <div class="label">
                <span class="label-text font-medium">Email</span>
              </div>
              <input 
                type="email" 
                id="email"
                name="email"
                placeholder="orionpax@cybertron.com" 
                class="input input-bordered w-full" 
                required 
              />
            </label>
            <label class="form-control w-full">
              <div class="label">
                <span class="label-text font-medium">Password</span>
              </div>
              <input 
                type="password" 
                id="password"
                name="password"
                placeholder="••••••••" 
                class="input input-bordered w-full"
                minlength="8" 
                required 
              />
            </label>
            <div class="card-actions mt-4">
              <button type="submit" class="btn btn-primary w-full">
                Register
              </button>
            </div>
            
            <p class="text-center text-sm mt-4">
              Already have an account? <a href="/login" class="link link-primary">Log in here</a>
            </p>
          </form>
        </div>
      </div>
    </main>
  </body>
</html>

<script>

    type ToastType = 'success' | 'error' | 'info' | 'warning';
    const toastContainer = document.getElementById('toast-container') as HTMLDivElement;

    function showToast(message: string, type: ToastType = 'info'): void {
        if (!toastContainer) return;
        const alertDiv = document.createElement('div');
        alertDiv.className = `alert alert-${type} shadow-lg transition-opacity duration-300`;
        alertDiv.innerHTML = `<span>${message}</span>`;
        toastContainer.appendChild(alertDiv);
        setTimeout(() => {
            alertDiv.style.opacity = '0';
            setTimeout(() => alertDiv.remove(), 300);
        }, 3000);
    }


    const form = document.getElementById('register-form') as HTMLFormElement;
    const API_URL = import.meta.env.PUBLIC_API_URL;

    form?.addEventListener('submit', async (e: Event) => {
        e.preventDefault();
        const formData = new FormData(form);
        const email = formData.get('email') as string;
        const password = formData.get('password') as string;
        const name = formData.get('name') as string;
        try {
            const response = await fetch(`${API_URL}/auth/register`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                email,
                password,
                // Only send the name if the user actually typed one
                ...(name ? { name } : {}) 
                }),
            });
            if (!response.ok) {
                const errorData = await response.json();
                // Handle NestJS error format (sometimes an array of Zod validation messages)
                const errorMessage = Array.isArray(errorData.message) 
                    ? errorData.message[0] 
                    : errorData.message;
                showToast(errorMessage || 'Registration failed', 'error');
                return;
            }
            // Success! Backend returns { user, accessToken, refreshToken }
            const data = await response.json();
            
            // Save tokens securely in localStorage
            localStorage.setItem('accessToken', data.accessToken);
            localStorage.setItem('refreshToken', data.refreshToken);
            showToast('Account created successfully! Redirecting...', 'success');
            form.reset();
            
            // Redirect to the dashboard (we will build this later!)
            setTimeout(() => {
                window.location.href = '/dashboard';
            }, 1500);
        } catch (err) {
            console.error(err);
            showToast('Failed to connect to Server.', 'error');
        }
    });




</script>



