---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>URL Shortener</title>
  </head>
  <body>

    <!-- Top Navigation Bar -->
  <div class="navbar bg-base-100 shadow-sm border-b border-base-200 px-4">
    <div class="flex-1">
      <a href="/" class="btn btn-ghost text-xl text-primary font-bold">URL Shortener</a>
    </div>
    
    <!-- State 1: Logged OUT (Hidden by default) -->
    <div id="nav-logged-out" class="flex-none gap-2 hidden">
      <a href="/login" class="btn btn-ghost">Log In</a>
      <a href="/register" class="btn btn-primary">Register</a>
    </div>

    <!-- State 2: Logged IN (Hidden by default) -->
    <div id="nav-logged-in" class="flex-none gap-2 hidden">
      <a href="/dashboard" class="btn btn-ghost">Dashboard</a>
      <button id="logout-btn" class="btn btn-outline btn-error btn-sm">Logout</button>
    </div>
  </div>





    <!-- bg-base-200 gives us a nice subtle background color -->
    <main class="min-h-screen bg-base-200 flex items-center justify-center p-4">

      <!-- Global Toast Container -->
      <div id="toast-container" class="toast toast-top toast-end z-50"></div>
      
      <!-- DaisyUI Card Component -->
      <div class="card w-full max-w-lg bg-base-100 shadow-xl">
        <div class="card-body">
          <h2 class="card-title text-3xl font-bold text-primary justify-center mb-2">
            URL Shortener
          </h2>
          <p class="text-center text-base-content/70 mb-6">
            Paste your long URL below to shorten it.
          </p>

          <form id="shorten-form" class="flex flex-col gap-4">
            
            <!-- DaisyUI Form Control -->
            <label class="form-control w-full">
              <div class="label">
                <span class="label-text font-medium">Long URL</span>
              </div>
              <input 
                type="url" 
                id="originalUrl"
                name="originalUrl"
                placeholder="https://example.com/very/long/link" 
                class="input input-bordered w-full" 
                required 
              />
            </label>

            <label class="form-control w-full">
              <div class="label">
                <span class="label-text font-medium">Custom Code (Optional)</span>
              </div>
              <input 
                type="text" 
                id="customCode"
                name="customCode"
                placeholder="e.g. my-link" 
                class="input input-bordered w-full" 
              />
            </label>

            <div class="card-actions mt-4">
              <button type="submit" class="btn btn-primary w-full">
                Shorten URL
              </button>
            </div>
          </form>

          <!-- Result Container (Hidden by default) -->
          <div id="result-container" class="hidden mt-6 flex-col gap-4">
            <div class="alert alert-success">
              <span>Short link generated successfully!</span>
            </div>
            
            <!-- DaisyUI Join (groups elements together nicely) -->
            <div class="join w-full">
              <input 
                type="text" 
                id="shortened-url" 
                class="input input-bordered join-item w-full" 
                readonly 
              />
              <button id="copy-btn" class="btn btn-secondary join-item">
                Copy
              </button>
            </div>
          </div>
          
        </div>
      </div>
    </main>
  </body>
</html>

<script>

  //token check
  const token = localStorage.getItem('accessToken');

  type ToastType = 'success' | 'error' | 'info' | 'warning';


	const form = document.getElementById('shorten-form') as HTMLFormElement;
	const resultContainer = document.getElementById('result-container');
	const shortenedUrlInput = document.getElementById('shortened-url') as HTMLInputElement;
	const copyBtn = document.getElementById('copy-btn');
  const toastContainer = document.getElementById('toast-container') as HTMLDivElement;

  //navbar elements
  const navLoggedOut = document.getElementById('nav-logged-out') as HTMLDivElement;
  const navLoggedIn = document.getElementById('nav-logged-in') as HTMLDivElement;
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;

  //navbar visiblity toggle
  if(token) {
    navLoggedIn?.classList.remove('hidden');
    navLoggedIn?.classList.add('flex');
  }else {
    navLoggedOut?.classList.remove('hidden');
    navLoggedOut?.classList.add('flex');
  }


  //logout from homepage
  logoutBtn?.addEventListener('click', () => {
    localStorage.removeItem('accessToken');
    localStorage.removeItem('refreshToken');
    //refresh
    window.location.reload();
  })


	const API_URL = import.meta.env.PUBLIC_API_URL;

	form?.addEventListener('submit', async (e) => {
		e.preventDefault();

		const formData = new FormData(form);
		const originalUrl = formData.get('originalUrl');
    	const customCode = formData.get('customCode');

		try{

			const response = await fetch(`${API_URL}/links`, {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json',
				},
				body: JSON.stringify({
					originalUrl,
					...(customCode ? {customCode} : {})
				}),
			});


			if(!response.ok){
				const errorData = await response.json();
				// alert(`Error: ${errorData.message || 'Something went wrong'}`);
        showToast(errorData.message || 'Something went wrng', 'error');
				return;
			}


			//success
			const data = await response.json();

			resultContainer?.classList.remove('hidden');
			resultContainer?.classList.add('flex');

			const shortCode = data.shortCode;
			if(shortenedUrlInput){
				shortenedUrlInput.value = `${API_URL}/${shortCode}`;
			}

			form.reset();


		}catch (err){
			console.error(err);
			showToast('Failed to connect to Server.', 'error')
		}
	});

	copyBtn?.addEventListener('click', () => {
		if(shortenedUrlInput?.value){
			navigator.clipboard.writeText(shortenedUrlInput.value);

      showToast('Link copied to clipboard!', 'success');

			const originalText = copyBtn.innerText;
			copyBtn.innerText = 'Copied';
			setTimeout(() => {
				copyBtn.innerText = originalText;
			}, 2000);
		}
	});


  function showToast(message: string, type: ToastType = 'info'): void {

    if(!toastContainer) return;

    const alertDiv = document.createElement('div');

    alertDiv.className = `alert alert-${type} shadow-lg transition-opacity duration-300`;

    alertDiv.innerHTML = `<span>${message}</span>`;

    toastContainer.appendChild(alertDiv);


    setTimeout(() => {
      alertDiv.style.opacity = '0';
      setTimeout(() => alertDiv.remove(), 300); // Wait for fade transition to finish
    }, 3000);
  }



</script>