---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Dashboard | URL Shortener</title>
  </head>
  <body>
    <!-- Top Navigation Bar -->
    <div class="navbar bg-base-100 shadow-sm border-b border-base-200 px-4">
      <div class="flex-1">
        <a href="/" class="btn btn-ghost text-xl text-primary font-bold">URL Shortener</a>
      </div>
      <div class="flex-none">
        <button id="logout-btn" class="btn btn-outline btn-error btn-sm">Logout</button>
      </div>
    </div>

    <!-- Main Content Area -->
    <main class="min-h-screen bg-base-200 p-4 md:p-8">
      
      <!-- Global Toast Container -->
      <div id="toast-container" class="toast toast-top toast-end z-50"></div>
      
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col sm:flex-row justify-between items-center mb-8 gap-4">
          <h1 class="text-3xl font-bold">My Dashboard</h1>
          <a href="/" class="btn btn-primary">Create New Link</a>
        </div>

        <!-- Loading Spinner -->
        <div id="loading-state" class="flex justify-center my-20">
          <span class="loading loading-spinner loading-lg text-primary"></span>
        </div>

        <!-- DaisyUI Data Table -->
        <div id="table-container" class="card bg-base-100 shadow-xl border border-base-300 hidden overflow-hidden">
          <div class="overflow-x-auto">
            <table class="table table-zebra w-full">
              <!-- head -->
              <thead class="bg-base-200 text-base-content">
                <tr>
                  <th>Short Code</th>
                  <th>Original URL</th>
                  <th>Status</th>
                  <th>Created At</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="links-table-body">
                <!-- Rows will be injected here via TypeScript -->
              </tbody>
            </table>
          </div>
        </div>
        
        <!-- Empty State (Shown if user has 0 links) -->
        <div id="empty-state" class="hidden text-center py-20 card bg-base-100 shadow-sm border border-base-300">
          <h3 class="text-xl font-bold mb-2">No links found</h3>
          <p class="text-base-content/60 mb-6">You haven't shortened any URLs yet.</p>
          <div>
            <a href="/" class="btn btn-primary">Create your first link</a>
          </div>
        </div>

      </div>

      <!-- Edit Link Modal -->
      <dialog id="edit-modal" class="modal">
        <div class="modal-box">
          <h3 class="font-bold text-lg mb-4">Edit Link</h3>
          <form id="edit-form" class="flex flex-col gap-4">
            <!-- Hidden input to store the ID of the link we are editing -->
            <input type="hidden" id="edit-link-id" />
            
            <label class="form-control w-full">
              <div class="label"><span class="label-text">Original URL</span></div>
              <input type="url" id="edit-original-url" class="input input-bordered w-full" required />
            </label>
            <label class="label cursor-pointer justify-start gap-4 mt-2">
              <span class="label-text">Active Status</span>
              <input type="checkbox" id="edit-is-active" class="toggle toggle-success" />
            </label>
            <div class="modal-action">
              <button type="button" class="btn" onclick="(document.getElementById('edit-modal')).close()">Cancel</button>
              <button type="submit" class="btn btn-primary">Save Changes</button>
            </div>
          </form>
        </div>
      </dialog>
      <!-- Delete Confirmation Modal -->
      <dialog id="delete-modal" class="modal">
        <div class="modal-box">
          <h3 class="font-bold text-lg text-error">Confirm Deletion</h3>
          <p class="py-4">Are you sure you want to delete this link? This action cannot be undone.</p>
          <div class="modal-action">
            <form method="dialog">
              <button class="btn">Cancel</button>
            </form>
            <button id="confirm-delete-btn" class="btn btn-error">Delete</button>
          </div>
        </div>
      </dialog>

    </main>
  </body>
</html>



<script>
  // 1. Setup Typed Toasts
  type ToastType = 'success' | 'error' | 'info' | 'warning';
  const toastContainer = document.getElementById('toast-container') as HTMLDivElement;

  function showToast(message: string, type: ToastType = 'info'): void {
    if (!toastContainer) return;
    const alertDiv = document.createElement('div');
    alertDiv.className = `alert alert-${type} shadow-lg transition-opacity duration-300`;
    alertDiv.innerHTML = `<span>${message}</span>`;
    toastContainer.appendChild(alertDiv);
    setTimeout(() => {
      alertDiv.style.opacity = '0';
      setTimeout(() => alertDiv.remove(), 300);
    }, 3000);
  }

  // 2. Auth Guard & Variables
  const API_URL = import.meta.env.PUBLIC_API_URL;
  const token = localStorage.getItem('accessToken');

  // DOM Elements
  const loadingState = document.getElementById('loading-state') as HTMLDivElement;
  const tableContainer = document.getElementById('table-container') as HTMLDivElement;
  const emptyState = document.getElementById('empty-state') as HTMLDivElement;
  const tableBody = document.getElementById('links-table-body') as HTMLTableSectionElement;
  const logoutBtn = document.getElementById('logout-btn') as HTMLButtonElement;

  // Define the expected shape of our Link data from NestJS
  interface Link {
    id: string;
    shortCode: string;
    originalUrl: string;
    isActive: boolean;
    createdAt: string;
  }

  // 3. Kickoff Logic
  if (!token) {
    // If there is no token in localStorage, kick them out to the login page immediately
    window.location.href = '/login';
  } else {
    // If they have a token, fetch their links
    fetchUserLinks();
  }

  // 4. Fetch Links from Backend
  async function fetchUserLinks(): Promise<void> {
    try {
      const response = await fetch(`${API_URL}/links`, {
        method: 'GET',
        headers: {
          'Content-Type': 'application/json',
          // Pass the JWT token exactly as NestJS expects it
          'Authorization': `Bearer ${token}` 
        }
      });

      if (!response.ok) {
        if (response.status === 401) {
          // Token is invalid or expired
          localStorage.removeItem('accessToken');
          localStorage.removeItem('refreshToken');
          window.location.href = '/login';
          return;
        }
        throw new Error('Failed to fetch links');
      }

      const links: Link[] = await response.json();
      renderLinks(links);
    } catch (err) {
      console.error(err);
      showToast('Could not load your links. Please try again.', 'error');
      loadingState.classList.add('hidden');
    }
  }

  // 5. Render Data to the HTML Table
  function renderLinks(links: Link[]): void {
    loadingState.classList.add('hidden'); // Hide the spinner

    if (links.length === 0) {
      emptyState.classList.remove('hidden'); // Show empty state message
      return;
    }

    tableContainer.classList.remove('hidden'); // Show the table

    links.forEach(link => {
      const row = document.createElement('tr');
      const shortUrl = `${API_URL}/${link.shortCode}`;
      
      row.innerHTML = `
        <td>
          <a href="${shortUrl}" target="_blank" class="link link-primary font-medium text-lg">
            /${link.shortCode}
          </a>
        </td>
        <td class="max-w-[200px] sm:max-w-xs truncate text-base-content/80" title="${link.originalUrl}">
          ${link.originalUrl}
        </td>
        <td>
          <div class="badge ${link.isActive ? 'badge-success' : 'badge-error'} badge-sm text-white">
            ${link.isActive ? 'Active' : 'Inactive'}
          </div>
        </td>
        <td class="text-sm text-base-content/70">
          ${new Date(link.createdAt).toLocaleDateString()}
        </td>
        <td>
          <div class="flex gap-2">
            <button class="btn btn-sm btn-secondary copy-btn" data-url="${shortUrl}">Copy</button>
            <button class="btn btn-sm btn-info edit-btn" data-id="${link.id}" data-url="${link.originalUrl}" data-active="${link.isActive}">Edit</button>
            <button class="btn btn-sm btn-error delete-btn" data-id="${link.id}">Delete</button>
          </div>
        </td>
      `;
      tableBody.appendChild(row);
    });

    // Attach event listeners to all newly created copy buttons
    const copyButtons = document.querySelectorAll('.copy-btn');
    copyButtons.forEach(btn => {
      btn.addEventListener('click', (e: Event) => {
        const target = e.currentTarget as HTMLButtonElement;
        const url = target.getAttribute('data-url');
        if (url) {
          navigator.clipboard.writeText(url);
          showToast('Short link copied!', 'success');
        }
      });
    });
  }

  // 6. Handle Logout
  logoutBtn?.addEventListener('click', () => {
    localStorage.removeItem('accessToken');
    localStorage.removeItem('refreshToken');
    window.location.href = '/login';
  });
</script>