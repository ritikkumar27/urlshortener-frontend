---
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Dashboard | URL Shortener</title>
  </head>
  <body>
    <!-- Top Navigation Bar -->
    <div class="navbar bg-base-100 shadow-sm border-b border-base-200 px-4">
      <div class="flex-1">
        <a href="/" class="btn btn-ghost text-xl text-primary font-bold">URL Shortener</a>
      </div>
      <div class="flex-none">
        <button id="logout-btn" class="btn btn-outline btn-error btn-sm">Logout</button>
      </div>
    </div>

    <!-- Main Content Area -->
    <main class="min-h-screen bg-base-200 p-4 md:p-8">
      
      <!-- Global Toast Container -->
      <div id="toast-container" class="toast toast-top toast-end z-50"></div>
      
      <div class="max-w-5xl mx-auto">
        <div class="flex flex-col sm:flex-row justify-between items-center mb-8 gap-4">
          <h1 class="text-3xl font-bold">My Dashboard</h1>
          <a href="/" class="btn btn-primary">Create New Link</a>
        </div>

        <!-- Loading Spinner -->
        <div id="loading-state" class="flex justify-center my-20">
          <span class="loading loading-spinner loading-lg text-primary"></span>
        </div>

        <!-- DaisyUI Data Table -->
        <div id="table-container" class="card bg-base-100 shadow-xl border border-base-300 hidden overflow-hidden">
          <div class="overflow-x-auto">
            <table class="table table-zebra w-full">
              <!-- head -->
              <thead class="bg-base-200 text-base-content">
                <tr>
                  <th>Short Code</th>
                  <th>Original URL</th>
                  <th>Status</th>
                  <th>Created At</th>
                  <th>Actions</th>
                </tr>
              </thead>
              <tbody id="links-table-body">
                <!-- Rows will be injected here via TypeScript -->
              </tbody>
            </table>
          </div>
        </div>
        
        <!-- Empty State (Shown if user has 0 links) -->
        <div id="empty-state" class="hidden text-center py-20 card bg-base-100 shadow-sm border border-base-300">
          <h3 class="text-xl font-bold mb-2">No links found</h3>
          <p class="text-base-content/60 mb-6">You haven't shortened any URLs yet.</p>
          <div>
            <a href="/" class="btn btn-primary">Create your first link</a>
          </div>
        </div>

      </div>
    </main>
  </body>
</html>