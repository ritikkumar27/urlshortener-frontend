---
import '../styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Login | URL Shortener</title>
  </head>
  <body>
    <main class="min-h-screen w-full flex items-center justify-center p-4">
      
      <!-- Global Toast Container -->
      <div id="toast-container" class="toast toast-top toast-end z-50"></div>
      <!-- Centered Card -->
      <div class="card w-full max-w-[450px] mx-auto bg-base-100 shadow-2xl border border-base-300">
        <div class="card-body">
          <h2 class="card-title text-3xl font-bold text-primary justify-center mb-2">
            Welcome Back
          </h2>
          <p class="text-center text-base-content/70 mb-6">
            Log in to manage your shortened links.
          </p>
          <form id="login-form" class="flex flex-col gap-4">
            
            <label class="form-control w-full">
              <div class="label">
                <span class="label-text font-medium">Email</span>
              </div>
              <input 
                type="email" 
                id="email"
                name="email"
                placeholder="you@example.com" 
                class="input input-bordered w-full" 
                required 
              />
            </label>
            <label class="form-control w-full">
              <div class="label">
                <span class="label-text font-medium">Password</span>
              </div>
              <input 
                type="password" 
                id="password"
                name="password"
                placeholder="••••••••" 
                class="input input-bordered w-full"
                required 
              />
            </label>
            <div class="card-actions mt-4">
              <button type="submit" class="btn btn-primary w-full">
                Log In
              </button>
            </div>
            
            <p class="text-center text-sm mt-4">
              Don't have an account? <a href="/register" class="link link-primary">Register here</a>
            </p>
          </form>
        </div>
      </div>
    </main>
  </body>
</html>